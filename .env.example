# Browser-visible deployment configuration. NEXT_PUBLIC_ values are not secrets.
NEXT_PUBLIC_BLUX_APP_ID=replace-with-blux-app-id
# mainnet or testnet. All generic STELLAR_* values below must match this network.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://your-testnet-horizon.example
NEXT_PUBLIC_STELLAR_RPC_URL=https://your-testnet-rpc.example
NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://your-testnet-explorer.example
NEXT_PUBLIC_STELLAR_USDC_ISSUER=replace-with-testnet-usdc-issuer
NEXT_PUBLIC_STELLAR_USDC_SAC_ADDRESS=replace-with-testnet-usdc-sac-address

# Optional server-only URL for Spot Mainnet Soroban quotes, e.g. http://127.0.0.1:8080.
# Leave empty to use only native Stellar AMM / order book quotes.
LUMIX_API_URL=
# Optional Mainnet RPC override when the app defaults to Testnet.
# Mainnet deployments use NEXT_PUBLIC_STELLAR_RPC_URL.
NEXT_PUBLIC_STELLAR_MAINNET_RPC_URL=https://mainnet.sorobanrpc.com

# Optional until the corresponding application contracts are deployed.
NEXT_PUBLIC_STELLAR_OPTIONS_CONTRACT_ADDRESS=
NEXT_PUBLIC_STELLAR_PERPETUALS_CONTRACT_ADDRESS=

NEXT_PUBLIC_PERPETUALS_PAYMENT_DESTINATION=replace-with-testnet-payment-destination

# Keep any future Blux App Secret server-only and unprefixed. Lumix currently
# has no server integration that requires one, so no App Secret is configured.
